# Idea-Man Environment Configuration Template
# STANDING RULE: Keep real secrets out of the repository.
# Real credentials, API keys, and sensitive tokens must be set via environment variables.

# Port for local static site preview server (default in site/preview.mjs is 4317)
PORT=4317

# Host for local preview server (default: 127.0.0.1)
HOST=127.0.0.1

# Optional AI API Keys (if running automated evaluations against remote APIs)
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
