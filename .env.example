# Environment Configuration Template for Idea-Man
# Copy this file to .env and adjust variables as needed for your environment.
# Note: Keep all real secrets and credentials OUT of git repository.

# Local preview server configuration
PORT=4317
HOST=127.0.0.1

# Optional API keys for external evaluation or integrations (do not commit real keys)
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
