# Idea-Man Environment Configuration Template
# Copy this file to .env to configure local environment variables.
# Never commit real secrets or credentials to the repository.

# Optional host API keys (Idea-Man standard library tools operate locally without these)
# OPENAI_API_KEY=sk-placeholder-do-not-commit-real-key
# ANTHROPIC_API_KEY=sk-placeholder-do-not-commit-real-key

# Optional preview port override
PORT=4317
